*.joblib
catboost_info/

# ── Training / prepare logs ───────────────────────────────────────────────────
data/*.log
*.log

# ── Weather cache (fetched from Open-Meteo, re-creatable) ────────────────────
weather_cache/
weather_cache_hourly/
weather_cache_dest/
weather_cache_dest_hourly/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.spyproject/
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Claude Code ───────────────────────────────────────────────────────────────
# Ignore the contents of .claude/ by default (personal settings, plans, history),
# but DO track project-level slash commands and the shared settings.json
# (which enables the flightright-modeldev plugin for all teammates).
# settings.local.json stays ignored — that's for per-user permissions.
.claude/*
!.claude/commands/
!.claude/settings.json

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
secrets.json
credentials.json
super_secret_dontcommit.txt
*dontcommit*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
# generic "something with API key" patterns — tighten if these false-positive
*api_key*
*apikey*
*api-key*
*_secret*
*token.txt
