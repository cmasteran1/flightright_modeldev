{
  "target": "dep",

  "output_enriched_unbalanced_path": "data/intermediate/WN_full_v3_unbalanced.parquet",
  "history_output_path": "data/intermediate/history_pool_dep_WN_v3_full.parquet",

  "features_dep": {
    "holiday_windows": {
      "thanksgiving": 2,
      "christmas": 3
    },
    "n_recent_flightnum_od": 30,
    "low_support_leq": 2,
    "rolling_windows_days": [1, 7, 14],
    "add_aircraft_type": true,
    "faa_registry": {
      "master_path": "../flightrightdata/data/meta/master.txt",
      "acftref_path": "../flightrightdata/data/meta/acftref.txt"
    },
    "hub_spillover": {
      "hubs": ["DEN", "PHX", "BWI", "MDW", "BNA"]
    }
  },

  "output_features_unbalanced_path": "data/processed/features_dep_WN_full_v4_unbalanced.parquet",

  "balance": {
    "thresholds": [15, 30, 45, 60],
    "delay_col": "DepDelayMinutes"
  },

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled": true,
      "by": "last_days",
      "last_days": 28,
      "output_path": "data/processed/features_dep_WN_full_v4_eval_unbalanced.parquet"
    },
    "thresholds": [15, 30, 45, 60],
    "pos_frac": 0.50,
    "seed": 42,
    "max_rows": 150000,
    "output_template": "data/processed/train_dep_ge{thr}_balanced_WN_full_v4.parquet"
  }
}
