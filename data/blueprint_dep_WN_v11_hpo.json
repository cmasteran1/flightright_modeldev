{
  "_comment": "HPO-scale variant of blueprint_dep_WN_v11. Mid-sized for local hyperparameter sweeps: 6 months of 2025 (Jan-Jun) at top 50 airports. ~300k rows — meaningful for detecting hyperparameter differences while keeping trials fast (~2-3 min each). History pool extends back 60 days into Nov 2024. Strike enabled if cache present. All v11 feature flags match production (NAS off, OTP on, cancel_anomaly on).",
  "_workflow": {
    "step_0": "python src/fetch_prune/collect_strike_cache.py",
    "step_1": "python src/fetch_prune/prepare_dataset.py data/blueprint_dep_WN_v11_hpo.json",
    "step_2": "python src/fetch_prune/features_dep.py    data/blueprint_dep_WN_v11_hpo.json",
    "step_3": "python src/training/hyperparam_optimize.py data/dep_train_WN_100_v11_hpo.json --n-trials N"
  },
  "_path_note": "Output paths use 'data/...' (resolved against DATA_ROOT = ../flightrightdata/). Input/meta paths use '../flightrightdata/data/...' (resolved against REPO_ROOT).",
  "target": "dep",
  "input_flights_path": [
    "../flightrightdata/data/raw_bts/Year=2025/Month=01/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2025/Month=02/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2025/Month=03/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2025/Month=04/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2025/Month=05/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2025/Month=06/flights.parquet"
  ],
  "history_flights_path": [
    "../flightrightdata/data/raw_bts/Year=2024/Month=1[1-2]/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2025/Month=0[1-6]/flights.parquet"
  ],
  "airports_csv": "../flightrightdata/data/meta/airports.csv",
  "airports_filter_csv": "../flightrightdata/data/meta/airport_rankings/WN_top_50.csv",
  "airlines": [
    "WN"
  ],
  "start_date": "2025-01-01",
  "end_date": "2025-06-30",
  "weather": {
    "daily": true,
    "hourly_at_dep": true,
    "dest_daily": false,
    "dest_hourly_at_arr": false,
    "cache_dir": "../flightrightdata/weather_cache",
    "hourly_cache_dir": "../flightrightdata/weather_cache_hourly",
    "historical_cache_dir": "../flightrightdata/weather_cache_historical"
  },
  "strike": {
    "enabled": false
  },
  "add_aircraft_type": false,
  "add_aircraft_age": false,
  "history_lookback_days": 60,
  "output_enriched_unbalanced_path": "data/intermediate/WN_v11_hpo_unbalanced.parquet",
  "history_output_path": "data/intermediate/history_pool_dep_WN_v11_hpo.parquet",
  "features_dep": {
    "holiday_windows": {
      "thanksgiving": 2,
      "christmas": 3
    },
    "n_recent_flightnum_od": 30,
    "low_support_leq": 2,
    "rolling_windows_days": [1, 7, 14],
    "hub_spillover": {
      "airline": "WN",
      "hubs": ["DEN", "PHX", "BWI", "MDW", "BNA"]
    },
    "hub_weather": { "enabled": false },
    "tail_history": { "enabled": false },
    "dest_rolling": { "enabled": true },
    "prior_leg": { "enabled": false },
    "strike": { "enabled": false },
    "delay_median_last1": { "enabled": true },
    "nas_rate_last1d": { "enabled": false },
    "cancel_rate_last1d": { "enabled": true },
    "divert_rate_last14d": { "enabled": true },
    "otp_rate_last14d": { "enabled": true },
    "cancel_anomaly_7d": { "enabled": true }
  },
  "output_features_unbalanced_path": "data/processed/features_dep_WN_v11_hpo_unbalanced.parquet",
  "balance": {
    "thresholds": [15, 30, 60, 120],
    "delay_col": "DepDelayMinutes",
    "pos_frac": 0.4
  },
  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled": true,
      "by": "random",
      "eval_frac": 0.15,
      "seed": 42,
      "output_path": "data/processed/features_dep_WN_v11_hpo_eval_unbalanced.parquet"
    },
    "thresholds": [15, 30, 60, 120],
    "pos_frac": 0.4,
    "seed": 42,
    "output_template": "data/processed/train_dep_ge{thr}_balanced_WN_v11_hpo.parquet",
    "max_rows": 3000000
  }
}
