{
  "_comment": "HPO blueprint: v8 WN arrival — uses dep v8 HPO enriched data. Same v8 arrival feature set as production.",
  "_workflow": {
    "prerequisite": "Complete both steps of blueprint_dep_v8_hpo.json first.",
    "step_1":       "python src/fetch_prune/features_arr.py data/blueprint_arr_v8_hpo.json"
  },

  "target": "arr",

  "output_enriched_unbalanced_path": "../flightrightdata/data/intermediate/WN_v8_hpo_unbalanced.parquet",
  "history_output_path":             "../flightrightdata/data/intermediate/history_pool_dep_WN_v8_hpo.parquet",

  "start_date": "2025-06-01",
  "end_date":   "2025-11-30",

  "dep_features_unbalanced_path": "../flightrightdata/data/processed/features_dep_WN_v8_hpo_unbalanced.parquet",

  "thresholds": [15, 30, 45, 60],

  "dest_weather": {
    "enabled":              true,
    "airports_csv":         "../flightrightdata/data/meta/airports.csv",
    "hourly_cache_dir":     "../flightrightdata/weather_cache_dest_hourly",
    "historical_cache_dir": "../flightrightdata/weather_cache_historical"
  },

  "output_features_unbalanced_path": "../flightrightdata/data/processed/features_arr_WN_v8_hpo_unbalanced.parquet",

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled":     true,
      "by":          "random",
      "eval_frac":   0.15,
      "seed":        42,
      "output_path": "../flightrightdata/data/processed/features_arr_WN_v8_hpo_eval_unbalanced.parquet"
    },
    "thresholds":      [15, 30, 45, 60],
    "pos_frac":        0.50,
    "seed":            42,
    "output_template": "../flightrightdata/data/processed/train_arr_ge{thr}_balanced_WN_v8_hpo.parquet"
  }
}
