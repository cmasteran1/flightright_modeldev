{
  "_comment": "Blueprint: v7g WN departure delay feature pipeline. Self-contained — generates all intermediate and processed files from raw BTS parquet. No pre-existing data required.",
  "_workflow": {
    "step_1": "python src/fetch_prune/prepare_dataset.py data/blueprint_dep_v7g.json",
    "step_2": "python src/fetch_prune/features_dep.py    data/blueprint_dep_v7g.json"
  },
  "_path_note": "Data output paths (output_enriched_unbalanced_path, history_output_path, output_features_unbalanced_path, feature_balance outputs) use the 'data/...' convention — prepare_dataset.py and features_dep.py both resolve these against DATA_ROOT (../flightrightdata/), so 'data/intermediate/foo.parquet' writes to ../flightrightdata/data/intermediate/foo.parquet. Meta/reference/input paths use '../flightrightdata/data/...' (REPO_ROOT-relative) because those functions resolve them against REPO_ROOT.",

  "target": "dep",

  "input_flights_path": [
    "../flightrightdata/data/raw_bts/Year=2023/Month=*/flights.parquet"
  ],
  "history_flights_path": [
    "../flightrightdata/data/raw_bts/Year=2022/Month=1[1-2]/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2023/Month=*/flights.parquet"
  ],

  "airports_csv": "../flightrightdata/data/meta/airports.csv",
  "airports_filter_csv": "../flightrightdata/data/meta/airport_rankings/WN_top_100.csv",
  "airlines": ["WN"],
  "start_date": "2023-01-01",
  "end_date":   "2023-12-31",

  "weather": {
    "daily":            true,
    "hourly_at_dep":    true,
    "dest_daily":       false,
    "dest_hourly_at_arr": false,
    "cache_dir":        "../flightrightdata/weather_cache",
    "hourly_cache_dir": "../flightrightdata/weather_cache_hourly"
  },

  "add_aircraft_type": true,
  "faa_registry": {
    "master_path":  "../flightrightdata/data/meta/master.txt",
    "acftref_path": "../flightrightdata/data/meta/acftref.txt"
  },
  "add_aircraft_age": true,
  "aircraft_registry_csv": "../flightrightdata/data/meta/aircraft_registry_clean.csv",

  "history_lookback_days": 60,
  "output_enriched_unbalanced_path": "data/intermediate/WN_v7g_unbalanced.parquet",
  "history_output_path":             "data/intermediate/history_pool_dep_WN_v7g.parquet",

  "features_dep": {
    "holiday_windows": {
      "thanksgiving": 2,
      "christmas":    3
    },
    "n_recent_flightnum_od": 30,
    "low_support_leq":       2,
    "rolling_windows_days":  [1, 7, 14],

    "add_aircraft_type": true,
    "faa_registry": {
      "master_path":  "../flightrightdata/data/meta/master.txt",
      "acftref_path": "../flightrightdata/data/meta/acftref.txt"
    },

    "hub_spillover": {
      "airline": "WN",
      "hubs": ["DEN", "PHX", "BWI", "MDW", "BNA"]
    },
    "hub_weather": {
      "enabled": false
    },
    "tail_history": {
      "enabled": true
    },
    "dest_rolling": {
      "enabled": true
    },
    "prior_leg": {
      "enabled": false
    }
  },

  "output_features_unbalanced_path": "data/processed/features_dep_WN_v7g_unbalanced.parquet",

  "balance": {
    "thresholds": [15, 30, 45, 60],
    "delay_col":  "DepDelayMinutes"
  },

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled":    true,
      "by":         "random",
      "eval_frac":  0.15,
      "seed":       42,
      "output_path": "data/processed/features_dep_WN_v7g_eval_unbalanced.parquet"
    },
    "thresholds":      [15, 30, 45, 60],
    "pos_frac":        0.50,
    "seed":            42,
    "output_template": "data/processed/train_dep_ge{thr}_balanced_WN_v7g.parquet"
  }
}
