{
  "_comment": "Smoke-test variant of blueprint_arr_WN_v10. Reads the smoke enriched parquet and history pool from blueprint_dep_WN_v10_smoke. dest_weather disabled to avoid network fetches outside the cached window.",
  "_workflow": {
    "prerequisite": "Complete both steps of blueprint_dep_WN_v10_smoke.json first.",
    "step_1":       "python src/fetch_prune/features_arr.py data/blueprint_arr_WN_v10_smoke.json"
  },

  "target": "arr",

  "output_enriched_unbalanced_path": "../flightrightdata/data/intermediate/WN_v10_smoke_unbalanced.parquet",
  "history_output_path":             "../flightrightdata/data/intermediate/history_pool_dep_WN_v10_smoke.parquet",

  "start_date": "2025-06-01",
  "end_date":   "2025-06-29",

  "dep_features_unbalanced_path": "../flightrightdata/data/processed/features_dep_WN_v10_smoke_unbalanced.parquet",

  "thresholds": [15, 30, 45, 60],

  "dest_weather": { "enabled": false },

  "arrdelay_median_14d": { "enabled": true },
  "recent_airtime":      { "enabled": false },
  "wheels_off_slip":     { "enabled": false },
  "elapsed_time_ratio":  { "enabled": true },

  "output_features_unbalanced_path": "../flightrightdata/data/processed/features_arr_WN_v10_smoke_unbalanced.parquet",

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled":     true,
      "by":          "random",
      "eval_frac":   0.15,
      "seed":        42,
      "output_path": "../flightrightdata/data/processed/features_arr_WN_v10_smoke_eval_unbalanced.parquet"
    },
    "thresholds":      [15, 30, 45, 60],
    "pos_frac":        0.50,
    "seed":            42,
    "output_template": "../flightrightdata/data/processed/train_arr_ge{thr}_balanced_WN_v10_smoke.parquet"
  }
}
