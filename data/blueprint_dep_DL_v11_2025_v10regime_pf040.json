      7,
      14
    ],
    "hub_spillover": {
      "airline": "DL",
      "hubs": [
        "ATL",
        "BOS",
        "DTW",
        "LAX",
        "JFK"
      ]
    },
    "hub_weather": {
      "enabled": false
    },
    "tail_history": {
      "enabled": false
    },
    "dest_rolling": {
      "enabled": true
    },
    "prior_leg": {
      "enabled": false
    },
    "strike": {
      "enabled": true,
      "cache_path": "../flightrightdata/strike_cache/us_aviation_labor_actions.parquet"
    },
    "delay_median_last1": {
      "enabled": true
    },
    "nas_rate_last1d": {
