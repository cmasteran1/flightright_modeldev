  "add_aircraft_type": false,
  "add_aircraft_age": false,
  "history_lookback_days": 60,
  "output_enriched_unbalanced_path": "../flightrightdata/data/intermediate/DL_v11_2025_unbalanced.parquet",
  "history_output_path": "../flightrightdata/data/intermediate/history_pool_dep_DL_v11_2025.parquet",
  "features_dep": {
