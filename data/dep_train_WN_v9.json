{
  "_comment": "Training config: v9 WN departure delay. v9 feature set adds tail/aircraft features and updated bin thresholds.",
  "input_features_path": "data/processed/features_dep_WN_v9_unbalanced.parquet",
  "eval_features_path": "data/processed/features_dep_WN_v9_eval_unbalanced.parquet",
  "outdir": "data/models/dep_WN_v9/",
  "thresholds": [15, 30, 60, 120],
  "bin_weights_minutes": [7.5, 22.5, 45.0, 90.0, 150.0],
  "random_seed": 1337,
  "per_threshold_train_paths": {
    "15": "data/processed/train_dep_ge15_balanced_WN_v9.parquet",
    "30": "data/processed/train_dep_ge30_balanced_WN_v9.parquet",
    "60": "data/processed/train_dep_ge60_balanced_WN_v9.parquet",
    "120": "data/processed/train_dep_ge120_balanced_WN_v9.parquet"
  },
  "iterations": 6000,
  "depth": 8,
  "learning_rate": 0.03,
  "l2_leaf_reg": 3.0,
  "od_wait": 200,
  "categorical_features": ["Origin", "Dest", "DepTimeBlk", "origin_dep_hour_weathercode", "aircraft_type"],
  "numeric_features": [
