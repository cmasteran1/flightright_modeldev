{
  "_comment": "v9 cancellation model training config. Cross-airline binary CatBoost classifier with full v9 departure feature set. Reporting_Airline included as categorical feature.",
  "_workflow": {
    "prerequisite": "Run blueprint_cancel_v9.json to generate balanced training and eval data.",
    "run": "python src/training/train_cancellation_catboost.py data/cancel_train_v9.json"
  },
  "_path_note": "All relative paths are resolved against DATA_ROOT (../flightrightdata/).",

  "input_features_path": "data/processed/train_cancel_balanced_v9.parquet",
  "eval_features_path": "data/processed/features_cancel_all_v9_eval_unbalanced.parquet",
  "outdir": "data/models/cancel_v9/",

  "target_col": "Cancelled",
  "random_seed": 42,
  "pos_frac": 0.20,

  "categorical_features": [
    "Origin",
    "Dest",
    "Reporting_Airline",
    "DepTimeBlk"
  ],

  "numeric_features": [
    "CRSDepTime",
    "CRSElapsedTime",
    "Distance",
    "is_peak_hour",

    "flightnum_od_depdelay_mean_last1",
    "flightnum_od_depdelay_mean_last7",
    "flightnum_od_depdelay_mean_last14",
    "flightnum_od_depdelay_median_last1",
    "flightnum_od_depdelay_median_last7",
    "flightnum_od_depdelay_median_last14",
    "flightnum_od_support_count_last14d",

    "carrier_depdelay_mean_last1",
    "carrier_depdelay_mean_last7",
    "carrier_origin_depdelay_mean_last1",
    "carrier_origin_depdelay_mean_last7",
    "carrier_origin_depdelay_mean_last14",
    "origin_depdelay_mean_last14",

    "origin_lateaircraft_rate_last1",
    "origin_lateaircraft_rate_last7",
    "carrier_lateaircraft_rate_last1",
    "carrier_lateaircraft_rate_last7",

    "hub_0_depdelay_mean_last1",
    "hub_0_depdelay_mean_last7",
    "hub_0_depdelay_mean_last14",
    "hub_0_lateaircraft_rate_last1",
    "hub_0_lateaircraft_rate_last7",
    "hub_0_lateaircraft_rate_last14",
    "hub_1_depdelay_mean_last1",
    "hub_1_depdelay_mean_last7",
    "hub_1_depdelay_mean_last14",
    "hub_1_lateaircraft_rate_last1",
    "hub_1_lateaircraft_rate_last7",
    "hub_1_lateaircraft_rate_last14",
    "hub_2_depdelay_mean_last1",
    "hub_2_depdelay_mean_last7",
    "hub_2_depdelay_mean_last14",
    "hub_2_lateaircraft_rate_last1",
    "hub_2_lateaircraft_rate_last7",
    "hub_2_lateaircraft_rate_last14",
    "hub_3_depdelay_mean_last1",
    "hub_3_depdelay_mean_last7",
    "hub_3_depdelay_mean_last14",
    "hub_3_lateaircraft_rate_last1",
    "hub_3_lateaircraft_rate_last7",
    "hub_3_lateaircraft_rate_last14",
    "hub_4_depdelay_mean_last1",
    "hub_4_depdelay_mean_last7",
    "hub_4_depdelay_mean_last14",
    "hub_4_lateaircraft_rate_last1",
    "hub_4_lateaircraft_rate_last7",
    "hub_4_lateaircraft_rate_last14",

    "dest_depdelay_mean_last1",
    "dest_lateaircraft_rate_last1",
    "dest_lateaircraft_rate_last7",
    "dest_lateaircraft_rate_last14",

    "origin_congestion_3h_total",
    "origin_airline_congestion_3h_total",

    "hub_max_lateaircraft_last1",
    "wind_x_precip",

    "days_to_strike",
    "carrier_delay_rate_anomaly_7d",

    "has_recent_arrival_turn_5h",
    "turn_time_hours",
    "tail_leg_num_day",
    "tail_depdelay_mean_last1",
    "tail_depdelay_mean_last14",
    "tail_lateaircraft_rate_last1",
    "tail_lateaircraft_rate_last14"
  ],

  "iterations": 4000,
  "depth": 8,
  "learning_rate": 0.03,
  "l2_leaf_reg": 5.0,
  "od_wait": 200,

  "split": {
    "val_size": 0.20
  },
  "unbalanced_cal_size": 0.50,

  "deploy_bundle_joblib_name": "cancellation_bundle_v9.joblib"
}
