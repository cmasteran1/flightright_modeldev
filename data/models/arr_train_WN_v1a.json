{
  "_comment": "WN arrival delay train v1a — fast iteration (1500 iter, 100K max rows). Uses dep v7c features merged + arrival-specific features.",

  "input_features_path": "data/processed/features_arr_WN_v1_unbalanced.parquet",
  "outdir":              "data/models/arr_WN_v1a",

  "eval_features_path":  "data/processed/features_arr_WN_v1_eval_unbalanced.parquet",

  "thresholds": [15, 30, 45, 60],

  "catboost": {
    "iterations":    1500,
    "depth":         8,
    "learning_rate": 0.04,
    "l2_leaf_reg":   3.0,
    "od_wait":       75,
    "verbose":       200,
    "seed":          42
  },

  "training": {
    "seed":           42,
    "max_train_rows": 100000,
    "earlystop_frac": 0.25,
    "test_frac":      0.25,
    "exclude_feature_prefixes": ["y_dep_ge", "y_dep1", "y_arr_ge"],
    "exclude_feature_columns": [
      "FlightDate", "dep_dt_local", "arr_dt_local", "dep_dt_utc", "arr_dt_utc",
      "prev_arr_dt_utc", "dep_local_date",
      "DepDelayMinutes", "ArrDelayMinutes",
      "Tail_Number", "Flight_Number_Reporting_Airline",
      "od_pair", "CRSArrTime", "prev_dest"
    ]
  },

  "eval": {
    "cal_size": 0.50
  },

  "feature_balance": {
    "output_template": "data/processed/train_arr_ge{thr}_balanced_WN_v1.parquet",
    "max_rows": 100000
  },

  "features": {
    "categorical": [
      "Reporting_Airline",
      "Origin",
      "Dest",
      "DepTimeBlk",
      "aircraft_type",
      "Aircraft_Age_Bucket"
    ],
    "numeric": [
      "CRSDepTime",
      "CRSElapsedTime",
      "Distance",
      "dep_dow",
      "sched_dep_hour",
      "sched_arr_hour",
      "flight_month",
      "is_holiday",
      "is_spring_break",
      "tail_leg_num_day",
      "flightnum_hours_since_first_departure_today",
      "has_recent_arrival_turn_5h",
      "turn_time_hours",
      "origin_congestion_3h_total",
      "origin_airline_congestion_3h_total",
      "origin_temperature_2m_max",
      "origin_temperature_2m_min",
      "origin_precipitation_sum",
      "origin_windspeed_10m_max",
      "origin_windgusts_10m_max",
      "origin_weathercode",
      "origin_dep_temperature_2m",
      "origin_dep_precipitation",
      "origin_dep_windspeed_10m",
      "origin_dep_weathercode",
      "origin_dep_windgusts_10m",
      "origin_dep_visibility",
      "origin_dep_cape",
      "origin_dep_cloudcover",
      "origin_daily_weathercode",
