{
  "input_features_unbalanced_path": "data/processed/features_dep_WN_small_unbalanced.parquet",
  "eval_features_path": "data/processed/features_dep_WN_small_eval_unbalanced.parquet",
  "outdir": "data/models/dep_WN_small/",

  "thresholds": [15, 30, 45, 60],

  "per_threshold_train_paths": {
    "15": "data/processed/train_dep_ge15_balanced_WN_small.parquet",
    "30": "data/processed/train_dep_ge30_balanced_WN_small.parquet",
    "45": "data/processed/train_dep_ge45_balanced_WN_small.parquet",
    "60": "data/processed/train_dep_ge60_balanced_WN_small.parquet"
  },

  "categorical_features": [
    "Origin", "Dest", "od_pair", "Reporting_Airline",
    "dep_dow", "sched_dep_hour", "is_holiday", "aircraft_type",
    "origin_daily_weathercode", "origin_dep_hour_weathercode",
    "has_recent_arrival_turn_5h"
  ],

  "numeric_features": [
    "origin_temp_max_K", "origin_temp_min_K",
    "origin_daily_precip_sum_mm", "origin_daily_windspeed_max_kmh",
    "origin_dep_temp_K", "origin_dep_precip_mm", "origin_dep_windspeed_kmh",
    "flightnum_od_depdelay_mean_last14",
    "flightnum_od_support_count_last14d",
    "flightnum_od_low_support_last14d",
    "carrier_depdelay_mean_last14",
    "carrier_origin_depdelay_mean_last14",
    "origin_depdelay_mean_last14",
    "turn_time_hours",
    "origin_congestion_3h_total",
    "origin_airline_congestion_3h_total",
    "tail_leg_num_day",
    "flightnum_hours_since_first_departure_today"
  ],

  "iterations": 600,
  "learning_rate": 0.05,
  "depth": 6,
  "l2_leaf_reg": 5.0,
  "od_wait": 80,
  "random_seed": 42,
  "reliability_bins": 8,
  "unbalanced_cal_size": 0.50,
  "max_rows": null,
  "prediction_samples_n": 200,

  "bin_weights_minutes": [7.5, 22.5, 37.5, 52.5, 75.0],
  "severity_weights": [0.0, 1.0, 2.0, 3.0, 4.0],

  "deploy_bundle_joblib_name": "dep_delay_bins_bundle_WN_small.joblib"
}
