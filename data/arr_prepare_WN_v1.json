{
  "_comment": "WN arrival delay features v1: 2023-only, random 15% holdout. Merges dep v7c features into arrival feature frame. Arrival-specific: route arr-delay rolling stats, dest congestion, sched_arr_hour.",
  "target": "arr",

  "output_enriched_unbalanced_path": "../flightrightdata/data/intermediate/WN_full_v3_unbalanced.parquet",
  "history_output_path":             "../flightrightdata/data/intermediate/history_pool_dep_WN_v3_full.parquet",

  "start_date": "2023-01-01",
  "end_date":   "2023-12-31",

  "dep_features_unbalanced_path": "../flightrightdata/data/processed/features_dep_WN_v7g_unbalanced.parquet",

  "thresholds": [15, 30, 45, 60],

  "output_features_unbalanced_path": "../flightrightdata/data/processed/features_arr_WN_v1_unbalanced.parquet",

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled": true,
      "by": "random",
      "eval_frac": 0.15,
      "seed": 42,
      "output_path": "../flightrightdata/data/processed/features_arr_WN_v1_eval_unbalanced.parquet"
    },
    "thresholds": [15, 30, 45, 60],
    "pos_frac": 0.50,
    "seed": 42,
    "output_template": "../flightrightdata/data/processed/train_arr_ge{thr}_balanced_WN_v1.parquet"
  }
}
