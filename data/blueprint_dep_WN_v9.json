  "airports_csv":        "../flightrightdata/data/meta/airports.csv",
  "airports_filter_csv": "../flightrightdata/data/meta/airport_rankings/WN_top_100.csv",
  "airlines": ["WN"],
  "start_date": "2024-01-01",
  "end_date":   "2025-11-30",

  "weather": {
    "daily":              true,
    "hourly_at_dep":      true,
    "dest_daily":         false,
    "dest_hourly_at_arr": false,
    "cache_dir":            "../flightrightdata/weather_cache",
    "hourly_cache_dir":     "../flightrightdata/weather_cache_hourly",
    "historical_cache_dir": "../flightrightdata/weather_cache_historical"
  },

  "strike": {
    "enabled":    true,
    "cache_path": "../flightrightdata/strike_cache/us_aviation_labor_actions.parquet"
  },

  "add_aircraft_type": true,
  "faa_registry": {
    "master_path":  "../flightrightdata/data/meta/master.txt",
    "acftref_path": "../flightrightdata/data/meta/acftref.txt"
  },
  "add_aircraft_age": false,

  "history_lookback_days": 60,
  "output_enriched_unbalanced_path": "data/intermediate/WN_v9_unbalanced.parquet",
  "history_output_path":             "data/intermediate/history_pool_dep_WN_v9.parquet",

  "features_dep": {
    "holiday_windows": { "thanksgiving": 2, "christmas": 3 },
    "n_recent_flightnum_od": 30,
    "low_support_leq": 2,
    "rolling_windows_days": [1, 7, 14],

    "add_aircraft_type": true,
    "faa_registry": {
      "master_path":  "../flightrightdata/data/meta/master.txt",
      "acftref_path": "../flightrightdata/data/meta/acftref.txt"
    },

    "hub_spillover": {
      "airline": "WN",
      "hubs": ["DEN", "PHX", "BWI", "MDW", "BNA"]
    },
    "hub_weather": { "enabled": false },
    "tail_history": { "enabled": true },
    "dest_rolling": { "enabled": true },
    "prior_leg":    { "enabled": false },
    "strike": {
      "enabled": true,
      "cache_path": "../flightrightdata/strike_cache/us_aviation_labor_actions.parquet"
    }
  },

  "output_features_unbalanced_path": "data/processed/features_dep_WN_v9_unbalanced.parquet",

  "balance": {
    "thresholds": [15, 30, 60, 120],
    "delay_col":  "DepDelayMinutes"
  },

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled":    true,
      "by":         "random",
      "eval_frac":  0.15,
      "seed":       42,
      "output_path": "data/processed/features_dep_WN_v9_eval_unbalanced.parquet"
    },
    "thresholds":      [15, 30, 60, 120],
    "pos_frac":        0.50,
    "seed":            42,
    "max_rows":        1000000,
    "output_template": "data/processed/train_dep_ge{thr}_balanced_WN_v9.parquet"
  }
}
