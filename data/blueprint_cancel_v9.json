{
  "_comment": "Blueprint: v9 cancellation model data preparation. Cross-airline binary classifier. Data from 2022 for sufficient cancelled samples. Target 20:80 cancelled:not-cancelled balance.",
  "_workflow": {
    "run": "python src/fetch_prune/prepare_cancel_dataset.py data/blueprint_cancel_v9.json"
  },

  "input_flights_path": "data/raw_bts/",
  "history_flights_path": "data/raw_bts/",

  "airlines": ["WN", "DL", "AA", "UA"],
  "start_date": "2022-01-01",
  "end_date": "2025-11-30",

  "weather": {
    "daily": {
      "enabled": true,
      "cache_dir": "data/weather_cache/daily"
    },
    "hourly_at_departure": {
      "enabled": true,
      "cache_dir": "data/weather_cache/hourly"
    }
  },

  "strike": {
    "enabled": true,
    "cache_path": "data/strike_cache.json"
  },

  "features_dep": {
    "tail_and_flightnum_time": true,
    "tail_history": {
      "enabled": true,
      "windows": [1, 14]
    },
    "hub_spillover": {
      "enabled": true,
      "hubs": ["ATL", "DEN", "DFW", "ORD", "EWR"]
    },
    "flightnum_od": {
      "n_recent": 20,
      "lookback_days": 14
    }
  },

  "output_features_unbalanced_path": "data/processed/features_cancel_all_v9_unbalanced.parquet",

  "feature_balance": {
    "eval": {
      "enabled": true,
      "eval_frac": 0.15,
      "output_path": "data/processed/features_cancel_all_v9_eval_unbalanced.parquet"
    }
  },

  "balance": {
    "pos_frac": 0.20,
    "seed": 42,
    "output_path": "data/processed/train_cancel_balanced_v9.parquet"
  }
}
