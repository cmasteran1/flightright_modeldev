{
  "_comment": "Blueprint: v7g WN departure delay training config. Trains 4 ordinal CatBoost classifiers P(delay >= 15/30/45/60 min). Run from REPO_ROOT after completing both steps of blueprint_dep_v7g.json. Hub features use positional names (hub_0_, hub_1_, ...) matching the order of features_dep.hub_spillover.hubs in the feature config — for WN v7g: hub_0=DEN, hub_1=PHX, hub_2=BWI, hub_3=MDW, hub_4=BNA.",
  "_workflow": {
    "prerequisite": "Both steps of blueprint_dep_v7g.json must be complete (features_dep_WN_v7g_unbalanced.parquet and balanced files must exist).",
    "run": "python src/training/train_dep_bins_ordinal_catboost.py data/blueprint_dep_train_v7g.json"
  },
  "_path_note": "All relative paths are resolved against DATA_ROOT (../flightrightdata/), so 'data/processed/foo.parquet' resolves to ../flightrightdata/data/processed/foo.parquet.",

  "input_features_path": "data/processed/features_dep_WN_v7g_unbalanced.parquet",
  "eval_features_path":  "data/processed/features_dep_WN_v7g_eval_unbalanced.parquet",
  "outdir":              "data/models/dep_WN_v7g/",

  "thresholds": [15, 30, 45, 60],
  "random_seed": 1337,

  "per_threshold_train_paths": {
    "15": "data/processed/train_dep_ge15_balanced_WN_v7g.parquet",
    "30": "data/processed/train_dep_ge30_balanced_WN_v7g.parquet",
    "45": "data/processed/train_dep_ge45_balanced_WN_v7g.parquet",
    "60": "data/processed/train_dep_ge60_balanced_WN_v7g.parquet"
  },

  "iterations":     1200,
  "depth":          8,
  "learning_rate":  0.08,
  "l2_leaf_reg":    3.0,
  "od_wait":        200,

  "categorical_features": [
    "Reporting_Airline",
    "Origin",
    "Dest",
    "DepTimeBlk",
    "aircraft_type",
    "Aircraft_Age_Bucket",
    "origin_dep_hour_weathercode"
  ],

  "numeric_features": [
    "flightnum_od_depdelay_mean_last1",    "flightnum_od_depdelay_mean_last7",    "flightnum_od_depdelay_mean_last14",
    "flightnum_od_depdelay_median_last1",  "flightnum_od_depdelay_median_last7",  "flightnum_od_depdelay_median_last14",
    "flightnum_od_depdelay_std_last1",     "flightnum_od_depdelay_std_last7",     "flightnum_od_depdelay_std_last14",
    "flightnum_od_support_count_last14d",  "flightnum_od_low_support_last14d",

    "carrier_depdelay_mean_last1",         "carrier_depdelay_mean_last7",         "carrier_depdelay_mean_last14",
    "carrier_depdelay_std_last1",          "carrier_depdelay_std_last7",          "carrier_depdelay_std_last14",

    "carrier_origin_depdelay_mean_last1",  "carrier_origin_depdelay_mean_last7",  "carrier_origin_depdelay_mean_last14",

    "origin_depdelay_mean_last1",          "origin_depdelay_mean_last7",          "origin_depdelay_mean_last14",

    "origin_lateaircraft_rate_last1",      "origin_lateaircraft_rate_last7",      "origin_lateaircraft_rate_last14",
    "carrier_lateaircraft_rate_last1",     "carrier_lateaircraft_rate_last7",     "carrier_lateaircraft_rate_last14",

    "hub_0_depdelay_mean_last1",           "hub_0_depdelay_mean_last7",           "hub_0_depdelay_mean_last14",
    "hub_0_lateaircraft_rate_last1",       "hub_0_lateaircraft_rate_last7",       "hub_0_lateaircraft_rate_last14",
    "hub_1_depdelay_mean_last1",           "hub_1_depdelay_mean_last7",           "hub_1_depdelay_mean_last14",
    "hub_1_lateaircraft_rate_last1",       "hub_1_lateaircraft_rate_last7",       "hub_1_lateaircraft_rate_last14",
    "hub_2_depdelay_mean_last1",           "hub_2_depdelay_mean_last7",           "hub_2_depdelay_mean_last14",
    "hub_2_lateaircraft_rate_last1",       "hub_2_lateaircraft_rate_last7",       "hub_2_lateaircraft_rate_last14",
    "hub_3_depdelay_mean_last1",           "hub_3_depdelay_mean_last7",           "hub_3_depdelay_mean_last14",
    "hub_3_lateaircraft_rate_last1",       "hub_3_lateaircraft_rate_last7",       "hub_3_lateaircraft_rate_last14",
    "hub_4_depdelay_mean_last1",           "hub_4_depdelay_mean_last7",           "hub_4_depdelay_mean_last14",
    "hub_4_lateaircraft_rate_last1",       "hub_4_lateaircraft_rate_last7",       "hub_4_lateaircraft_rate_last14",

    "tail_depdelay_mean_last1",            "tail_depdelay_mean_last7",            "tail_depdelay_mean_last14",
    "tail_lateaircraft_rate_last1",        "tail_lateaircraft_rate_last7",        "tail_lateaircraft_rate_last14",

    "dest_depdelay_mean_last1",            "dest_depdelay_mean_last7",            "dest_depdelay_mean_last14",
    "dest_lateaircraft_rate_last1",        "dest_lateaircraft_rate_last7",        "dest_lateaircraft_rate_last14",

    "origin_congestion_3h_total",
    "origin_airline_congestion_3h_total",

    "dep_dow",
    "sched_dep_hour",
    "tail_leg_num_day",
    "turn_time_hours",
    "is_holiday",
    "CRSDepTime",
    "CRSElapsedTime",
    "Distance",

    "origin_temp_max_K",
    "origin_temp_min_K",
    "origin_daily_precip_sum_mm",
    "origin_daily_windspeed_max_kmh",
    "origin_daily_windgusts_max_kmh",

    "origin_dep_temp_K",
    "origin_dep_precip_mm",
    "origin_dep_windspeed_kmh",
    "origin_dep_windgusts_kmh",
    "origin_dep_visibility_m",
    "origin_dep_cape_jkg",
    "origin_dep_log1p_cape",
    "origin_dep_cloudcover_pct"
  ],

  "deploy_bundle_joblib_name": "dep_delay_bins_bundle_WN_v7g.joblib"
}
