{
  "_comment": "v10 WN arrival delay training config. Starts from v8, removes wo_slip_*_d_* and airtime_*_d_* (wheels-off-derived), removes the *_mean_last1 baselines that were promoted to *_median_last1, and adds: 14d arrival delay medians (arrdelay_median_14d_{fn,car}_od), elapsed_time_ratio_last14d (gate-based, AeroDataBox-safe), and the same three new AeroDataBox aggregates as the dep model. No tail-derived features.",
  "_workflow": {
    "prerequisite": "Complete blueprint_dep_WN_v10.json (both steps) and blueprint_arr_WN_v10.json.",
    "run": "python src/training/train_arr_bins_ordinal_catboost.py data/arr_train_WN_100_v10.json"
  },
  "_path_note": "All relative paths resolved against DATA_ROOT (../flightrightdata/).",
  "input_features_path": "../flightrightdata/data/processed/features_arr_WN_v10_unbalanced.parquet",
  "eval_features_path": "../flightrightdata/data/processed/features_arr_WN_v10_eval_unbalanced.parquet",
  "outdir": "../flightrightdata/data/models/arr_WN_100_v10/",
  "thresholds": [
    15,
    30,
    45,
    60
  ],
  "feature_balance": {
    "output_template": "../flightrightdata/data/processed/train_arr_ge{thr}_balanced_WN_v10.parquet"
  },
  "training": {
    "seed": 1337,
    "exclude_feature_prefixes": [
      "y_dep_ge"
    ],
    "exclude_feature_columns": [],
    "max_train_rows": 0
  },
  "eval": {
    "last_days": 90,
    "cal_size": 0.5
  },
  "catboost": {
    "iterations": 6000,
    "depth": 9,
    "learning_rate": 0.03,
    "l2_leaf_reg": 3.0,
    "od_wait": 200,
    "seed": 1337,
    "verbose": 200,
    "thread_count": -1
  },
  "features": {
