{
  "_comment": "v10 WN departure delay training config. Starts from v8, removes the *_mean_last1 baselines for carrier/carrier_origin/hub/dest (replaced by *_median_last1) and the flightnum_od_depdelay_mean_last1 (kept median sibling), and adds the three AeroDataBox-compatible aggregates origin_nasdelay_rate_last1d / cancel_rate_origin_last1d / divert_rate_origin_last14d. No tail-number-derived features. Hubs: hub_0=DEN, hub_1=PHX, hub_2=BWI, hub_3=MDW, hub_4=BNA.",
  "_workflow": {
    "prerequisite": "Both steps of blueprint_dep_WN_v10.json must be complete.",
    "run": "python src/training/train_dep_bins_ordinal_catboost.py data/dep_train_WN_100_v10.json"
  },
  "_path_note": "All relative paths are resolved against DATA_ROOT (../flightrightdata/).",
  "input_features_path": "data/processed/features_dep_WN_v10_unbalanced.parquet",
  "eval_features_path": "data/processed/features_dep_WN_v10_eval_unbalanced.parquet",
  "outdir": "data/models/dep_WN_100_v10/",
  "thresholds": [15, 30, 45, 60],
  "random_seed": 1337,
  "per_threshold_train_paths": {
    "15": "data/processed/train_dep_ge15_balanced_WN_v10.parquet",
    "30": "data/processed/train_dep_ge30_balanced_WN_v10.parquet",
    "45": "data/processed/train_dep_ge45_balanced_WN_v10.parquet",
    "60": "data/processed/train_dep_ge60_balanced_WN_v10.parquet"
  },
  "iterations": 6000,
  "depth": 8,
  "learning_rate": 0.03,
  "l2_leaf_reg": 3.0,
  "od_wait": 200,
  "categorical_features": [
    "Origin",
    "Dest",
    "DepTimeBlk",
    "origin_dep_hour_weathercode"
  ],
  "numeric_features": [
