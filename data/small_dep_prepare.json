{
  "target": "dep",

  "input_flights_path": [
    "../flightrightdata/data/raw_bts/Year=2024/Month=01/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2024/Month=02/flights.parquet"
  ],

  "airports_csv": "../flightrightdata/data/meta/airports.csv",
  "airports_filter_csv": "../flightrightdata/data/meta/airport_rankings/WN_top_50.csv",
  "airports_filter_column": "IATA",
  "airlines": ["WN"],

  "start_date": "2024-01-01",
  "end_date": "2024-02-29",

  "weather": {
    "daily": true,
    "hourly_at_dep": true,
    "dest_daily": false,
    "dest_hourly_at_arr": false,
    "cache_dir": "weather_cache",
    "hourly_cache_dir": "weather_cache_hourly",
    "dest_cache_dir": "weather_cache_dest",
    "dest_hourly_cache_dir": "weather_cache_dest_hourly"
  },

  "add_aircraft_type": true,
  "add_aircraft_age": true,
  "aircraft_registry_csv": "../flightrightdata/data/meta/aircraft_registry_clean.csv",

  "output_enriched_unbalanced_path": "data/intermediate/WN_small_unbalanced.parquet",

  "history_flights_path": [
    "../flightrightdata/data/raw_bts/Year=2023/Month=11/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2023/Month=12/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2024/Month=01/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2024/Month=02/flights.parquet"
  ],
  "history_lookback_days": 60,
  "history_output_path": "data/intermediate/history_pool_dep_WN_small.parquet",

  "features_dep": {
    "holiday_windows": {
      "thanksgiving": 2,
      "christmas": 3
    },
    "n_recent_flightnum_od": 20,
    "low_support_leq": 2,
    "rolling_windows_days": [14],
    "add_aircraft_type": true,
    "faa_registry": {
      "master_path": "../flightrightdata/data/meta/master.txt",
      "acftref_path": "../flightrightdata/data/meta/acftref.txt"
    }
  },

  "output_features_unbalanced_path": "data/processed/features_dep_WN_small_unbalanced.parquet",

  "balance": {
    "thresholds": [15, 30, 45, 60],
    "delay_col": "DepDelayMinutes"
  },

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled": true,
      "by": "last_days",
      "last_days": 28,
      "output_path": "data/processed/features_dep_WN_small_eval_unbalanced.parquet"
    },
    "thresholds": [15, 30, 45, 60],
    "pos_frac": 0.50,
    "seed": 42,
    "max_rows": 4000,
    "output_template": "data/processed/train_dep_ge{thr}_balanced_WN_small.parquet"
  }
}
