{
  "_comment": "Blueprint: v9 DL arrival delay. Depends on completed dep v9 pipeline.",
  "_workflow": {
    "prerequisite": "Complete both steps of blueprint_dep_DL_v9.json first.",
    "step_1": "python src/fetch_prune/features_arr.py data/blueprint_arr_DL_v9.json"
  },
  "target": "arr",
  "output_enriched_unbalanced_path": "../flightrightdata/data/intermediate/DL_v9_unbalanced.parquet",
  "history_output_path": "../flightrightdata/data/intermediate/history_pool_dep_DL_v9.parquet",
  "start_date": "2024-01-01",
  "end_date": "2025-11-30",
  "dep_features_unbalanced_path": "../flightrightdata/data/processed/features_dep_DL_v9_unbalanced.parquet",
  "thresholds": [
    15,
    30,
    60,
    120
  ],
  "dest_weather": {
    "enabled": true,
    "airports_csv": "../flightrightdata/data/meta/airports.csv",
    "hourly_cache_dir": "../flightrightdata/weather_cache_dest_hourly",
    "historical_cache_dir": "../flightrightdata/weather_cache_historical"
  },
  "output_features_unbalanced_path": "../flightrightdata/data/processed/features_arr_DL_v9_unbalanced.parquet",
  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled": true,
      "by": "random",
      "eval_frac": 0.15,
      "seed": 42,
      "output_path": "../flightrightdata/data/processed/features_arr_DL_v9_eval_unbalanced.parquet"
    },
    "thresholds": [
      15,
      30,
      60,
      120
    ],
    "pos_frac": 0.5,
    "seed": 42,
    "max_rows": 1000000,
    "output_template": "../flightrightdata/data/processed/train_arr_ge{thr}_balanced_DL_v9.parquet"
  }
}