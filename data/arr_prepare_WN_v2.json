{
  "_comment": "WN arrival feature prepare v2 — adds destination hourly weather at scheduled arrival time. Otherwise identical to v1.",

  "target": "arr",

  "output_enriched_unbalanced_path": "../flightrightdata/data/intermediate/WN_full_v3_unbalanced.parquet",
  "history_output_path":             "../flightrightdata/data/intermediate/history_pool_dep_WN_v3_full.parquet",

  "start_date": "2023-01-01",
  "end_date":   "2023-12-31",

  "dep_features_unbalanced_path": "../flightrightdata/data/processed/features_dep_WN_v7g_unbalanced.parquet",

  "thresholds": [15, 30, 45, 60],

  "output_features_unbalanced_path": "../flightrightdata/data/processed/features_arr_WN_v2_unbalanced.parquet",

  "dest_weather": {
    "enabled":          true,
    "airports_csv":     "../flightrightdata/data/meta/airports.csv",
    "hourly_cache_dir": "../flightrightdata/weather_cache_dest_hourly"
  },

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled":    true,
      "by":         "random",
      "eval_frac":  0.15,
      "seed":       42,
      "output_path": "../flightrightdata/data/processed/features_arr_WN_v2_eval_unbalanced.parquet"
    },
    "thresholds": [15, 30, 45, 60],
    "pos_frac":   0.50,
    "seed":       42,
    "output_template": "../flightrightdata/data/processed/train_arr_ge{thr}_balanced_WN_v2.parquet"
  }
}
