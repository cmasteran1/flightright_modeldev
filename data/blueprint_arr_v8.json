{
  "_comment": "Blueprint: v8 WN arrival delay feature pipeline (2024-2025). Reads enriched parquet and history pool from blueprint_dep_v8 step 1, and departure features from step 2. Run features_arr.py only.",
  "_workflow": {
    "prerequisite": "Complete both steps of blueprint_dep_v8.json first.",
    "step_1":       "python src/fetch_prune/features_arr.py data/blueprint_arr_v8.json"
  },
  "_path_note": "All data paths use '../flightrightdata/data/...' (REPO_ROOT-relative) because features_arr.py resolves all paths against REPO_ROOT.",

  "target": "arr",

  "output_enriched_unbalanced_path": "../flightrightdata/data/intermediate/WN_v8_unbalanced.parquet",
  "history_output_path":             "../flightrightdata/data/intermediate/history_pool_dep_WN_v8.parquet",

  "start_date": "2024-01-01",
  "end_date":   "2025-11-30",

  "dep_features_unbalanced_path": "../flightrightdata/data/processed/features_dep_WN_v8_unbalanced.parquet",

  "thresholds": [15, 30, 45, 60],

  "dest_weather": {
    "enabled":              true,
    "airports_csv":         "../flightrightdata/data/meta/airports.csv",
    "hourly_cache_dir":     "../flightrightdata/weather_cache_dest_hourly",
    "historical_cache_dir": "../flightrightdata/weather_cache_historical"
  },

  "output_features_unbalanced_path": "../flightrightdata/data/processed/features_arr_WN_v8_unbalanced.parquet",

  "feature_balance": {
    "enabled": true,
    "eval": {
      "enabled":     true,
      "by":          "random",
      "eval_frac":   0.15,
      "seed":        42,
      "output_path": "../flightrightdata/data/processed/features_arr_WN_v8_eval_unbalanced.parquet"
    },
    "thresholds":      [15, 30, 45, 60],
    "pos_frac":        0.50,
    "seed":            42,
    "output_template": "../flightrightdata/data/processed/train_arr_ge{thr}_balanced_WN_v8.parquet"
  }
}
