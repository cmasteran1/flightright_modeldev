{
  "_comment": "TEST blueprint: v8 WN departure — 5 airports, 1 month, for pipeline validation only.",
  "_workflow": {
    "step_0": "python src/fetch_prune/collect_strike_cache.py",
    "step_1": "python src/fetch_prune/prepare_dataset.py data/blueprint_dep_v8_test.json",
    "step_2": "python src/fetch_prune/features_dep.py    data/blueprint_dep_v8_test.json"
  },

  "target": "dep",

  "input_flights_path": [
    "../flightrightdata/data/raw_bts/Year=2024/Month=10/flights.parquet"
  ],
  "history_flights_path": [
    "../flightrightdata/data/raw_bts/Year=2024/Month=9/flights.parquet",
    "../flightrightdata/data/raw_bts/Year=2024/Month=10/flights.parquet"
  ],

  "airports_csv": "../flightrightdata/data/meta/airports.csv",
  "airports_filter_csv": "../flightrightdata/data/meta/airport_rankings/WN_test_5.csv",
  "airlines": ["WN"],
  "start_date": "2024-10-01",
  "end_date":   "2024-10-31",

  "weather": {
    "daily":            true,
    "hourly_at_dep":    true,
    "dest_daily":       false,
    "dest_hourly_at_arr": false,
    "cache_dir":        "../flightrightdata/weather_cache",
    "hourly_cache_dir": "../flightrightdata/weather_cache_hourly",
    "historical_cache_dir": "../flightrightdata/weather_cache_historical"
  },

  "strike": {
    "enabled": true,
    "cache_path": "../flightrightdata/strike_cache/us_aviation_labor_actions.parquet"
  },

  "add_aircraft_type": true,
  "faa_registry": {
    "master_path":  "../flightrightdata/data/meta/master.txt",
    "acftref_path": "../flightrightdata/data/meta/acftref.txt"
  },
  "add_aircraft_age": true,
  "aircraft_registry_csv": "../flightrightdata/data/meta/aircraft_registry_clean.csv",

  "history_lookback_days": 30,
  "output_enriched_unbalanced_path": "data/intermediate/WN_v8_test_unbalanced.parquet",
  "history_output_path":             "data/intermediate/history_pool_dep_WN_v8_test.parquet",

  "features_dep": {
    "holiday_windows": {
      "thanksgiving": 2,
      "christmas":    3
    },
    "n_recent_flightnum_od": 30,
    "low_support_leq":       2,
    "rolling_windows_days":  [1, 7, 14],

    "add_aircraft_type": true,
    "faa_registry": {
      "master_path":  "../flightrightdata/data/meta/master.txt",
      "acftref_path": "../flightrightdata/data/meta/acftref.txt"
    },

    "hub_spillover": {
      "airline": "WN",
      "hubs": ["DEN", "PHX", "BWI", "MDW", "BNA"]
    },
    "hub_weather": {
      "enabled": false
    },
    "tail_history": {
      "enabled": true
    },
    "dest_rolling": {
      "enabled": true
    },
    "prior_leg": {
      "enabled": false
    },
    "strike": {
      "enabled": true,
      "cache_path": "../flightrightdata/strike_cache/us_aviation_labor_actions.parquet"
    }
  },

  "output_features_unbalanced_path": "data/processed/features_dep_WN_v8_test_unbalanced.parquet",

  "balance": {
    "thresholds": [15, 30, 45, 60],
    "delay_col":  "DepDelayMinutes"
  },

  "feature_balance": {
    "enabled": false
  }
}
